{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "EnvironmentVariables": {
    "SqlConnection": "CUSTOMERPORTAL_SQLCONNECTION"
  },

  "AllowedOrigins": [],

  "Database": {
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10,
    "CommandTimeoutSeconds": 60
  },

  "Hashing": {
    "Iterations": 3,
    "MemorySizeKb": 32768,
    "DegreeOfParallelism": 2,
    "HashLengthBytes": 32,
    "SaltLengthBytes": 16
  },

  "Otp": {
    "CodeLength": 4,
    "ExpiryMinutes": 5,
    "MaxVerificationAttempts": 3,
    "ResendCooldownSeconds": 30,
    "MaxResendsPerWindow": 5,
    "ResendWindowMinutes": 60,
    "ReturnCodeInResponse": false
  },

  "Pin": {
    "Length": 4,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },

  "Onboarding": {
    "BiometricSecretByteLength": 32,
    "EnforceChannelOrder": true
  },

  "RateLimiting": {
    "OtpSend": { "PermitLimit": 3, "WindowSeconds": 60 },
    "OtpVerify": { "PermitLimit": 10, "WindowSeconds": 60 },
    "PinVerify": { "PermitLimit": 10, "WindowSeconds": 300 },
    "RegistrationStart": { "PermitLimit": 10, "WindowSeconds": 60 }
  }
}
