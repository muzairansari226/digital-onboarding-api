{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedOrigins": [ "https://localhost:3000", "http://localhost:3000" ],

  "Otp": {
    // Development only. With no SMS or email provider wired up yet, this is what lets the journey
    // be walked end to end from Swagger. It must stay false anywhere a real customer can reach.
    "ReturnCodeInResponse": true
  },

  "RateLimiting": {
    "OtpSend": { "PermitLimit": 30, "WindowSeconds": 60 }
  }
}
